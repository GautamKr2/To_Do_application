<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>To Do App</title>
    <link rel="stylesheet" href="/style.css" />
</head>
<body>
    <%- include('navbar') %>
    <div class="container">
        <div class="container-items">
            <h1> To Do List </h1>
            <form action="/multi-delete" method="post">
                <button class="delete" id="multiple-delete"> Delete selected task </button>
                <ul class="task-list">
                    <% for(let i=0; i<taskList.length; i++) { %>
                        <li>
                            <div class="task-items">
                                <%= taskList[i].title %> <br/>
                                <p> <%= taskList[i].description %> </p>

                                <input type="checkbox" name="selectedTask" value="<%= taskList[i]._id %>">
                                <!-- <a href="/delete/<%= taskList[i]._id %>" class="delete"> Delete </a> -->
                                <button onclick="deleteTask('<%= taskList[i]._id %>')" class="delete"> Delete </button>

                                <a href="/update/<%= taskList[i]._id %>" class="update"> Update </a>
                            </div>
                        </li>
                        <br/>
                    <% } %>
                </ul>
            </form>
        </div>
    </div>
    <script src="/script.js"></script>
</body>
</html>